{
  "name": "easeapply",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that autofills job application forms from your profile and drafts custom answers with Gemini.",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build && vite build -c vite.content.config.ts",
    "watch": "npm run clean && concurrently -k \"vite build --watch\" \"vite build --watch -c vite.content.config.ts\"",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "serve:test": "npx --yes http-server test-pages -p 8080 -c-1"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular/build": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@types/chrome": "^0.1.0",
    "concurrently": "^9.0.0",
    "jsdom": "^26.1.0",
    "terser": "^5.51.2",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
