{
  "manifest_version": 3,
  "name": "EaseApply",
  "version": "1.0.0",
  "description": "Fill job application forms in one click from your profile and resume, with Gemini-drafted answers for custom questions.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "EaseApply",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-fill": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill known fields on the current page from your profile"
    }
  }
}
